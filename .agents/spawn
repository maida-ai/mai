#!/usr/bin/env bash
# Usage: .agents/spawn <cheap|mid|high> <planner|implementer|verifier> <brief.md>
#
# The only sanctioned way to start a sub-agent, whatever harness runs it.
# - logs every spawn to $MAI_RUN_DIR/spawns.jsonl (the ledger's source of truth)
# - enforces the depth limit
# - gives each agent its own branch, in a worktree that exists only while it runs
# Harness and model per tier live in .agents/tiers.sh.
set -euo pipefail

die() { echo "spawn: $*" >&2; exit 2; }
[[ $# -eq 3 ]] || die "usage: spawn <tier> <role> <brief.md>"
tier=$1 role=$2 brief=$3

case $role in planner|implementer|verifier) ;; *) die "unknown role: $role" ;; esac
[[ -f $brief ]] || die "brief not found: $brief"
brief="$(cd "$(dirname "$brief")" && pwd)/$(basename "$brief")"
grep -q '^DONE WHEN:' "$brief" || die "brief has no DONE WHEN line. Use the template in .agents/agent-rules.md (Delegating), fix the brief and resubmit."

: "${MAI_RUN_ID:?set MAI_RUN_ID}"
: "${MAI_RUN_DIR:?set MAI_RUN_DIR (absolute path to runs/<run-id>)}"
depth=${MAI_AGENT_DEPTH:-1}
max=${MAI_MAX_DEPTH:-3}
(( depth < max )) || die "refused: depth $depth is at the limit ($max)"

here=$(cd "$(dirname "$0")" && pwd)
# shellcheck source=/dev/null
source "${MAI_TIERS_FILE:-$here/tiers.sh}"
declare -F "run_$tier" >/dev/null || die "unknown tier: $tier"
desc_var="$(echo "$tier" | tr '[:lower:]' '[:upper:]')_DESC"
harness=${!desc_var:-unknown}

id="$(date +%H%M%S)-$role-$RANDOM"
parent=${MAI_AGENT_ID:-executor}
branch="agent/$MAI_RUN_ID/$id"
main_root=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")
wt_root=${MAI_WORKTREE_ROOT:-"$main_root/.worktrees"}
wt="$wt_root/$id"
mkdir -p "$MAI_RUN_DIR/agents" "$wt_root"
git worktree add -q -b "$branch" "$wt" HEAD

prompt="$MAI_RUN_DIR/agents/$id.prompt.md"
log="$MAI_RUN_DIR/agents/$id.log"
{
  echo "Role: $role sub-agent (id $id, depth $((depth + 1)) of max $max)."
  echo "Read AGENTS.md for project conventions. The kit rules below also apply."
  echo
  cat "$here/agent-rules.md"
  echo
  if [[ $role == planner ]]; then
    echo "Delegate only via .agents/spawn. Never use built-in subagent tools."
  else
    echo "Do not spawn other agents."
  fi
  echo "Commit code changes on the current branch ($branch); the worktree is deleted when you"
  echo "exit, and anything uncommitted is left off your branch. Don't write your report to a"
  echo "file or commit it: print the 'Reporting back' block above as your final output."
  echo
  echo "# Your brief"
  echo
  cat "$brief"
} > "$prompt"

start=$(date -u +%FT%TZ)
touch "$MAI_RUN_DIR/agents/$id.running"
set +e
( cd "$wt"
  export MAI_AGENT_DEPTH=$((depth + 1)) MAI_AGENT_ID=$id
  export GIT_AUTHOR_NAME="mai-$role $id" GIT_AUTHOR_EMAIL="$id@agents.mai.local"
  export GIT_COMMITTER_NAME="$GIT_AUTHOR_NAME" GIT_COMMITTER_EMAIL="$GIT_AUTHOR_EMAIL"
  "run_$tier" "$prompt" ) > "$log" 2>&1
rc=$?
set -e
end=$(date -u +%FT%TZ)
rm -f "$MAI_RUN_DIR/agents/$id.running"

# The branch holds the work; the worktree was only scaffolding. Save anything left
# uncommitted as a patch so nothing is lost, then remove the worktree.
uncommitted=""
if [[ -n $(git -C "$wt" status --porcelain 2>/dev/null) ]]; then
  uncommitted="$MAI_RUN_DIR/agents/$id.uncommitted.patch"
  git -C "$wt" add -A && git -C "$wt" diff --cached --binary > "$uncommitted"
fi
git worktree remove --force "$wt" || echo "warning: couldn't remove $wt" >&2
# Harness exit 0 only means the process ended. The agent's own STATUS line is the outcome.
status=$(grep -oE '^STATUS: *[a-z_]+' "$log" | tail -n 1 | sed 's/^STATUS: *//' || true)
status=${status:-missing}

printf '{"id":"%s","parent":"%s","role":"%s","tier":"%s","harness":"%s","brief":"%s","branch":"%s","start":"%s","end":"%s","exit":%d,"status":"%s","uncommitted":"%s"}\n' \
  "$id" "$parent" "$role" "$tier" "$harness" "$brief" "$branch" "$start" "$end" "$rc" "$status" "$uncommitted" \
  >> "$MAI_RUN_DIR/spawns.jsonl"

echo "agent $id exit=$rc status=$status branch=$branch log=$log${uncommitted:+ uncommitted=$uncommitted}"
tail -n 30 "$log"
exit "$rc"
