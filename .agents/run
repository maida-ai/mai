#!/usr/bin/env bash
# .agents/run start <slug> "<directive>"   interactive executor session for a new run
# .agents/run auto <slug> "<directive>"    unattended, in the background: executor, evaluator, post-mortem
# .agents/run status [run-id]              progress of a run (default: latest); runs on the host
# .agents/run list                         every run with its phase; runs on the host
# .agents/run stop <run-id>                stop a background run and clean up after it
# .agents/run review <run-id> [--skip "<reason>"]   record your review; required before the next run
# .agents/run rework <run-id> <slug> ["<extra>"]   new unattended run on top of a reviewed run's branch
# .agents/run eval <run-id>                run the independent evaluator on a finished run
# .agents/run publish <run-id>             push run/<id> and open a draft PR (also automatic at run end)
# .agents/run sync                         fetch the latest default branch into origin/<branch>
# .agents/run doctor                       check the environment; no model calls
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$here/.." && pwd)
# shellcheck source=/dev/null
source "$here/config.sh"
# shellcheck source=/dev/null
source "$here/tiers.sh"
usage() { sed -n '2,12p' "$0" | sed 's/^# //'; exit 2; }

# Read-only view of a run, from the files it writes. Needs no container.
status() {
  local id=${1:-$(ls -1t "$root/runs" 2>/dev/null | head -n 1)}
  local dir="$root/runs/$id"
  [[ -n $id && -d $dir ]] || { echo "no runs yet" >&2; return 2; }
  local cname="mai-$id" state="not running"
  if command -v docker >/dev/null && docker ps --format '{{.Names}}' 2>/dev/null | grep -qx "$cname"; then
    state="running ($cname)"
  fi
  local started; started=$(stat -c %Y "$dir/directive.txt" 2>/dev/null || echo 0)
  echo "run      $id"
  echo "phase    $(cat "$dir/phase" 2>/dev/null || echo interactive)   container: $state"
  echo "elapsed  $(( ($(date +%s) - started) / 60 )) min"
  echo "directive: $(head -c 160 "$dir/directive.txt")"
  echo
  if [[ -f $dir/spawns.jsonl ]]; then
    echo "finished agents:"
    python3 - "$dir/spawns.jsonl" <<'PY'
import json, sys
for line in open(sys.argv[1]):
    r = json.loads(line)
    print(f"  {r['id']:<28} {r['role']:<11} {r['tier']:<5} {r['status']:<11} exit={r['exit']}")
PY
  fi
  local f any=""
  for f in "$dir"/agents/*.running; do
    [[ -e $f ]] || continue
    [[ -z $any ]] && { echo "running agents:"; any=1; }
    echo "  $(basename "$f" .running)  $(( ($(date +%s) - $(stat -c %Y "$f")) / 60 )) min"
  done
  for f in triage.md scope.md claim.md evaluation.md proposals.md escalations.md report.md; do
    [[ -f $dir/$f ]] && printf '%s ' "$f"
  done; echo
  local log="$dir/executor.log"
  [[ -f $dir/postmortem.log ]] && log="$dir/postmortem.log"
  if [[ -f $log ]]; then echo; echo "tail of $(basename "$log"):"; tail -n 15 "$log" | sed 's/^/  /'; fi
}

list_runs() {
  local d id phase running
  running=$(command -v docker >/dev/null && docker ps --format '{{.Names}}' 2>/dev/null || true)
  for d in $(ls -1dt "$root"/runs/*/ 2>/dev/null); do
    id=$(basename "$d"); phase=$(cat "$d/phase" 2>/dev/null || echo interactive)
    grep -qx "mai-$id" <<<"$running" && phase="$phase (running)"
    printf '%-32s %-24s %s\n' "$id" "$phase" "$(head -c 60 "$d/directive.txt" 2>/dev/null)"
  done
}

# Kit agents may sync, check and read status; starting, stopping or publishing runs is
# for people (or their interactive sessions), never for agents inside a run.
case ${1:-} in
  start|auto|stop|publish|prepare|execute|finish|review|rework)
    if [[ -n ${MAI_AGENT_ID:-} ]]; then
      echo "refused: agents inside a run can't use '.agents/run $1'" >&2; exit 2
    fi ;;
esac

# A rework run starts from the reviewed run's branch, with your review as its brief.
rework_directive() {
  local old=$1 extra=${2:-} f="$root/runs/$1/review.md" pr
  [[ -f $f ]] || { echo "run $old has no review.md" >&2; return 2; }
  [[ $(cat "$root/runs/$old/phase" 2>/dev/null) == reviewed ]] \
    || { echo "review run $old first (.agents/run review $old)" >&2; return 2; }
  awk '/^### P1/{f=1} f&&/^Decision:/{sub(/^Decision: */,""); print; exit}' "$f" | grep -q '^rework' \
    || { echo "run $old's PR decision isn't 'rework: ...'" >&2; return 2; }
  pr=$(grep -o 'https://[^ ]*' "$root/runs/$old/publish.log" 2>/dev/null | tail -n 1 || true)
  printf 'Rework of run %s%s. You start on its branch, so its work is already in your tree. Address every decision Zafar recorded in its review, quoted below; keep what he accepted and change what he rejected. Context: runs/%s/evaluation.md and claim.md. %s\n\n--- review of %s ---\n%s\n' \
    "$old" "${pr:+ (PR $pr)}" "$old" "$extra" "$old" "$(cat "$f")"
}

[[ ${1:-} == status ]] && { shift; status "$@"; exit $?; }
[[ ${1:-} == list ]] && { list_runs; exit 0; }

# On the host, re-run this same command inside the container. Agents run with the
# sandbox bypassed, which is only acceptable in a disposable box.
if [[ -z ${MAI_IN_CONTAINER:-} ]]; then
  command -v docker >/dev/null || { echo "docker not found; agents only run in the container" >&2; exit 2; }
  docker info >/dev/null 2>&1 || {
    echo "can't reach the Docker daemon as $USER. Check: docker run --rm hello-world" >&2
    echo "Fix: add yourself to the docker group, or use rootless Docker. Don't run this with sudo." >&2
    exit 2; }
  docker image inspect mai-agents >/dev/null 2>&1 \
    || docker build -t mai-agents -f "$here/Dockerfile" "$here"
  # Mount only your Codex login. The rest of ~/.codex is host-specific (installed
  # binaries, symlinks to host paths); the container keeps its own copy in a volume.
  auth=()
  if [[ -f $HOME/.codex/auth.json ]]; then
    auth=(-v "$HOME/.codex/auth.json":/root/.codex/auth.json)
  elif [[ -z ${OPENAI_API_KEY:-} ]]; then
    echo "no ~/.codex/auth.json and no OPENAI_API_KEY; log in to codex on the host first" >&2
    exit 2
  fi
  # Same path inside and out, so worktree paths and logs stay valid on the host.
  # Settings resolved here (environment, config.local.sh, defaults) go into the container.
  cfg_env=(); for v in "${MAI_CONFIG_VARS[@]}"; do cfg_env+=(-e "$v"); done
  common=(--rm --init -v "$root":"$root" -w "$root" "${cfg_env[@]}"
          -v mai-codex-home:/root/.codex ${auth[@]+"${auth[@]}"}
          -e OPENAI_API_KEY -e GH_TOKEN -e MAI_IN_CONTAINER=1)
  if [[ ${1:-} == stop ]]; then
    [[ $# -eq 2 ]] || usage
    docker stop "mai-$2" >/dev/null 2>&1 && echo "stopped mai-$2" || echo "mai-$2 wasn't running"
    exec docker run "${common[@]}" mai-agents "$here/run" finish "$2"
  fi
  if [[ ${1:-} == auto || ${1:-} == rework ]]; then
    if [[ $1 == auto ]]; then
      [[ $# -eq 3 ]] || usage
      prep=(prepare "$2" "$3")
    else
      [[ $# -ge 3 ]] || usage
      directive=$(rework_directive "$2" "${4:-}") || exit 2
      prep=(prepare "$3" "$directive" "run/$2")
    fi
    # Setup runs in the foreground, so every failure is visible here. Only the model
    # work goes to the background.
    out=$(docker run "${common[@]}" mai-agents "$here/run" "${prep[@]}" 2>&1) \
      || { echo "$out" >&2; exit 2; }
    id=$(grep -m1 '^RUN_ID=' <<<"$out" | cut -d= -f2)
    cname="mai-$id"
    docker run -d --name "$cname" "${common[@]}" mai-agents "$here/run" execute "$id" >/dev/null
    echo "started $cname in the background"
    echo "  progress:  .agents/run status $id     (or: watch -n 15 .agents/run status)"
    echo "  phases:    docker logs -f $cname"
    echo "  inside:    docker exec -it $cname bash"
    echo "  stop:      docker stop $cname"
    exit 0
  fi
  tty=-i; [[ -t 0 && -t 1 ]] && tty=-it
  name=(); [[ ${1:-} == start ]] && name=(--name "mai-$(date -u +%F)-${2:-x}")
  exec docker run $tty ${name[@]+"${name[@]}"} "${common[@]}" mai-agents "$here/run" "$@"
fi

KIT=(INTENT.md AGENTS.md CLAUDE.md .agents)
[[ -n ${GH_TOKEN:-} ]] && gh auth setup-git >/dev/null 2>&1 || true

# Fetch the default branch over HTTPS (the container has no SSH keys) into
# refs/remotes/origin/<branch>. Sets BASE_REF. Without GH_TOKEN, falls back to HEAD.
sync_base() {
  BASE_REF=HEAD
  [[ -n ${GH_TOKEN:-} ]] || return 0
  local b url
  b=$(gh repo view --json defaultBranchRef -q .defaultBranchRef.name) || return 1
  url="$(gh repo view --json url -q .url).git"
  # Another run may be fetching the same ref right now; ref locks make one of us retry.
  local try
  for try in 1 2 3 4 5; do
    git fetch -q "$url" "+refs/heads/$b:refs/remotes/origin/$b" 2>/dev/null && { BASE_REF="origin/$b"; return 0; }
    sleep $((try * 2))
  done
  return 1
}

doctor() {
  local fail=0
  ok() { echo "ok    $*"; }
  bad() { echo "FAIL  $*"; fail=1; }
  warn() { echo "warn  $*"; }
  cd "$root"

  command -v cargo >/dev/null && ok "cargo $(cargo --version | cut -d' ' -f2)" || bad "cargo not on PATH"
  bash -lc 'command -v cargo' >/dev/null 2>&1 && ok "cargo in login shell" || bad "cargo missing in login shell"
  local gv; gv=$(git --version | awk '{print $3}')
  [[ $(printf '2.40\n%s\n' "$gv" | sort -V | head -n 1) == 2.40 ]] && ok "git $gv" || bad "git $gv < 2.40"
  command -v codex >/dev/null && ok "codex on PATH" || bad "codex not on PATH"
  [[ -f $HOME/.codex/auth.json || -n ${OPENAI_API_KEY:-} ]] && ok "codex auth" || bad "no codex auth"
  if [[ -n ${GH_TOKEN:-} ]]; then
    if gh auth status >/dev/null 2>&1; then
      ok "gh authenticated"
      # Dry-run push to a probe ref: contacts GitHub with write auth, changes nothing.
      if git push --dry-run "$(gh repo view --json url -q .url).git" HEAD:refs/heads/mai-doctor-probe >/dev/null 2>&1; then
        ok "GH_TOKEN can push branches"
      else
        warn "GH_TOKEN can't push: runs won't publish a branch or PR (token needs Contents: read/write)"
      fi
    else
      bad "GH_TOKEN set but gh auth fails"
    fi
  else
    warn "no GH_TOKEN: no issue grooming, no push, no PR"
  fi
  git check-ignore -q runs/x && git check-ignore -q .worktrees/x && git check-ignore -q .agents/config.local.sh \
    && ok "runs/, .worktrees/, .agents/config.local.sh ignored" \
    || bad "add runs/, .worktrees/ and .agents/config.local.sh to .gitignore"
  [[ -x $(git rev-parse --path-format=absolute --git-common-dir)/hooks/pre-commit ]] \
    && ok "pre-commit hook installed" || bad "pre-commit hook missing"

  # Agents' worktrees branch from HEAD, so they only see the committed kit.
  if git diff --quiet HEAD -- "${KIT[@]}" && [[ -z $(git ls-files --others --exclude-standard -- "${KIT[@]}") ]]; then
    ok "kit committed"
    if [[ -n ${GH_TOKEN:-} ]]; then
      if ! sync_base; then
        bad "can't fetch the default branch with GH_TOKEN"
      elif git diff --quiet "$BASE_REF" HEAD -- "${KIT[@]}"; then
        ok "kit matches $BASE_REF (runs start there)"
      else
        bad "kit differs from $BASE_REF, where runs start. Push your kit commits first."
      fi
    fi
  else
    bad "kit has uncommitted changes; agents' worktrees won't see them. Commit: ${KIT[*]}"
    echo "skip  spawn test (needs a committed kit)"
    return $fail
  fi

  # Depth-2 and depth-3 spawn through the committed kit, with a stub instead of a model.
  local tmp; tmp=$(mktemp -d)
  cat > "$tmp/tiers.sh" <<'STUB'
CHEAP_DESC=stub
run_cheap() {
  if grep -q '^Role: planner' "$1"; then
    printf 'TASK: doctor-impl\nDONE WHEN: true\n' > "$MAI_RUN_DIR/briefs/impl.md"
    .agents/spawn cheap implementer "$MAI_RUN_DIR/briefs/impl.md" >/dev/null || { echo "STATUS: failed"; return; }
  fi
  echo "STATUS: done"
}
STUB
  mkdir -p "$tmp/run/briefs"
  printf 'TASK: doctor-plan\nDONE WHEN: true\n' > "$tmp/run/briefs/plan.md"
  local rid="doctor-$$"
  ( export MAI_RUN_ID=$rid MAI_RUN_DIR=$tmp/run MAI_TIERS_FILE=$tmp/tiers.sh \
           MAI_WORKTREE_ROOT=$tmp/wt MAI_AGENT_DEPTH=1 MAI_AGENT_ID=doctor
    "$here/spawn" cheap planner "$tmp/run/briefs/plan.md" ) >/dev/null 2>&1
  local done_rows; done_rows=$(grep -c '"status":"done"' "$tmp/run/spawns.jsonl" 2>/dev/null || true)
  [[ $done_rows == 2 ]] && ok "spawn depth 2 and 3" \
    || bad "spawn test: expected 2 done rows, got ${done_rows:-0}; see $tmp/run"
  local w b
  for w in "$tmp"/wt/*; do [[ -d $w ]] && git worktree remove --force "$w"; done
  for b in $(git for-each-ref --format='%(refname:short)' "refs/heads/agent/$rid/"); do git branch -q -D "$b"; done
  [[ $fail == 0 ]] && rm -rf "$tmp"
  return $fail
}

# The review sheet: the few decisions a person must make before trusting a run.
# Built from the evaluator's spot checks and the post-mortem's decisions, not from the
# executor's own summary, so the executor can't soften what you're asked to check.
build_review() {
  local id=$1 dir="$root/runs/$1" out="$root/runs/$1/review.md" pr n=0 line ev
  ev="$dir/evaluation.md"
  pr=$(grep -o 'https://[^ ]*' "$dir/publish.log" 2>/dev/null | tail -n 1 || true)
  section() { awk -v h="$1" '$0 ~ "^ *"h":"{f=1;next} f&&/^ *[A-Z][A-Z ]+:/{f=0} f&&/^ *- /{sub(/^ *- */,""); print}' "$ev" 2>/dev/null; }
  {
    echo "# Review: $id"
    echo
    echo "Answer the items below, then run \`.agents/run review $id\`. Short answers are fine."
    echo "The next run starts only after this one is reviewed."
    echo
    echo "## What changed"
    n=0
    while IFS= read -r line; do n=$((n + 1)); echo "- $line"; done < <(section CHANGES)
    [[ $n == 0 ]] && echo "- (the evaluator didn't summarize the changes; see the PR)"
    echo
    echo "## Did it work"
    echo "- $(grep -m1 '^ *VERDICT:' "$ev" 2>/dev/null | sed 's/^ *VERDICT: */Evaluator: /' || echo 'Evaluator: no verdict')"
    echo "- $(grep -m1 '^NORTH STAR:' "$dir/report.md" 2>/dev/null | sed 's/^NORTH STAR: */North star: /' || echo 'North star: not reported')"
    echo "- $(grep -m1 '^SPEND:' "$dir/report.md" 2>/dev/null | sed 's/^SPEND: */Spend: /' || echo 'Spend: not reported')"
    echo "- PR: ${pr:-not published}"
    echo
    echo "## Your checks"
    echo "Answer each with: pass, fail: <what you saw>, or unsure: <why>."
    echo "Any fail means the PR can't be marked ready."
    n=0
    while IFS= read -r line; do
      n=$((n + 1)); printf '\n### S%d\n%s\nDecision: \n' "$n" "$line"
    done < <(section "SPOT CHECKS")
    if [[ $n == 0 ]]; then
      printf '\n### S1\nThe evaluator gave no checks. Open the PR and check that its first change is what you asked for.\nDecision: \n'
    fi
    echo
    echo "## Your decisions"
    echo "Answer each with ok (take the recommendation), A / B, or your own words."
    n=0
    while IFS= read -r line; do
      n=$((n + 1)); printf '\n### D%d\n%s\nDecision: \n' "$n" "${line#- }"
    done < <(grep '^- ' "$dir/decisions.md" 2>/dev/null | head -n 3)
    [[ $n == 0 ]] && printf '\nNone.\n'
    echo
    echo "## The PR"
    printf '\n### P1\nready (leaves draft; you merge it on GitHub) / rework: <what> (then .agents/run rework %s <slug>) / close\nDecision: \n' "$id"
    echo
    echo "---"
    echo "Reference, not required: report.md (incl. \"Decided without you\"), evaluation.md,"
    echo "proposals.md, escalations.md, alignment.md or triage.md, claim.md in runs/$id/."
  } > "$out"
}

review_run() {
  local id=$1 dir="$root/runs/$1" f="$root/runs/$1/review.md" open pr_decision
  [[ -d $dir ]] || { echo "no run $id" >&2; return 2; }
  [[ -f $f ]] || build_review "$id"
  if [[ ${2:-} == --skip ]]; then
    [[ -n ${3:-} ]] || { echo "--skip needs a reason" >&2; return 2; }
    printf '\nSKIPPED %s: %s\n' "$(date -u +%FT%TZ)" "$3" >> "$f"
    echo skipped > "$dir/phase"; echo "review of $id skipped; reason recorded in runs/$id/review.md"
    return 0
  fi
  open=$(awk '/^### /{h=$2} /^Decision: *$/{print h}' "$f" | tr '\n' ' ')
  if [[ -n $open ]]; then
    echo "runs/$id/review.md still needs decisions: $open" >&2
    return 1
  fi
  pr_decision=$(awk '/^### P1/{f=1} f&&/^Decision:/{sub(/^Decision: */,""); print; exit}' "$f")
  local failed; failed=$(awk '/^### S/{h=$2} /^Decision: *[Ff]ail/{print h}' "$f" | tr '\n' ' ')
  if [[ -n $failed && $pr_decision == ready* ]]; then
    echo "check(s) $failed failed, so the PR can't be ready. Use rework: <what> or close." >&2
    return 1
  fi
  printf '\nREVIEWED %s\n' "$(date -u +%FT%TZ)" >> "$f"
  echo reviewed > "$dir/phase"
  case $pr_decision in
    ready*)
      [[ -n ${GH_TOKEN:-} ]] && ( cd "$root" && gh pr ready "run/$id" ) && echo "PR marked ready; merge it on GitHub" ;;
    rework*)
      echo "next: .agents/run rework $id <slug>   (starts from run/$id with this review as the brief)" ;;
    close*)
      [[ -n ${GH_TOKEN:-} ]] && ( cd "$root" && gh pr close "run/$id" --comment "Closed in review: $pr_decision" ) && echo "PR closed" ;;
  esac
  echo "reviewed $id. Apply what you accepted: INTENT.md Decisions, executor.md edits. Then commit and push."
}

# Set up a run: env, run dir, and the executor's own worktree on branch run/<run-id>,
# so your checkout is never touched.
executor_env() {
  export MAI_RUN_ID=$1 MAI_RUN_DIR="$root/runs/$1" MAI_WORKTREE_ROOT="$root/.worktrees"
  export MAI_AGENT_DEPTH=1 MAI_AGENT_ID=executor
  mai_git_identity executor "$1"
  RUN_WT="$MAI_WORKTREE_ROOT/run-$1"
}

# Create a run, or fail loudly without leaving anything half-made behind.
setup_run() {
  local id; id="$(date +%F)-$1"
  executor_env "$id"
  if [[ -e $MAI_RUN_DIR ]]; then
    local phase; phase=$(cat "$MAI_RUN_DIR/phase" 2>/dev/null || echo unknown)
    echo "run $id already exists (phase: $phase)." >&2
    case $phase in
      executor|evaluating|post-mortem)
        echo "It may still be running: .agents/run status $id. Use a new slug." >&2 ;;
      *) echo "Use a new slug, or discard it: rm -rf runs/$id && git branch -D run/$id" >&2 ;;
    esac
    exit 2
  fi
  local d pending=""
  for d in "$root"/runs/*/; do
    [[ $(cat "$d/phase" 2>/dev/null) == needs-review ]] && pending+=" $(basename "$d")"
  done
  if [[ -n $pending ]]; then
    echo "unreviewed runs:$pending" >&2
    echo "Review each: fill runs/<id>/review.md, then .agents/run review <id>" >&2
    echo "Or skip on the record: .agents/run review <id> --skip \"<reason>\"" >&2
    exit 2
  fi
  if git -C "$root" rev-parse -q --verify "refs/heads/run/$id" >/dev/null; then
    echo "branch run/$id exists without a run directory. Delete it: git branch -D run/$id" >&2
    exit 2
  fi
  local base main_ref
  ( cd "$root" && sync_base && echo "$BASE_REF" ) > "$root/.base.$$" \
    || { rm -f "$root/.base.$$"; echo "can't fetch the default branch" >&2; exit 2; }
  main_ref=$(cat "$root/.base.$$"); rm -f "$root/.base.$$"
  base=$main_ref
  if [[ -n ${3:-} ]]; then
    git -C "$root" rev-parse -q --verify "refs/heads/$3" >/dev/null \
      || { echo "base branch $3 doesn't exist" >&2; exit 2; }
    base=$3
  fi
  mkdir -p "$MAI_RUN_DIR/briefs"
  [[ $base == run/* ]] && echo "${base#run/}" > "$MAI_RUN_DIR/supersedes.txt"
  printf '%s\n' "$2" > "$MAI_RUN_DIR/directive.txt"
  local v; for v in "${MAI_CONFIG_VARS[@]}"; do printf '%s=%s\n' "$v" "${!v}"; done > "$MAI_RUN_DIR/config.txt"
  printf '%s\n%s\n' "$base" "$(git -C "$root" rev-parse "$base")" > "$MAI_RUN_DIR/base.txt"
  # --no-track: branching from origin/<b> would otherwise write upstream config to the
  # shared .git/config, which collides when two runs start at the same moment.
  git -C "$root" worktree add -q --no-track -b "run/$id" "$RUN_WT" "$base" \
    || { rm -rf "$MAI_RUN_DIR"; echo "couldn't create the run worktree" >&2; exit 2; }
  # A rework starts from an older run's branch, which carries the kit as it was then.
  # Bring it onto the current default branch first, so this run uses today's kit.
  if [[ $base != "$main_ref" ]] && ! git -C "$RUN_WT" merge-base --is-ancestor "$main_ref" HEAD; then
    if ! git -C "$RUN_WT" rebase -q "$main_ref" >/dev/null 2>&1; then
      git -C "$RUN_WT" rebase --abort >/dev/null 2>&1
      git -C "$root" worktree remove --force "$RUN_WT"; git -C "$root" branch -q -D "run/$id"
      rm -rf "$MAI_RUN_DIR"
      echo "$base doesn't rebase cleanly onto $main_ref. Rebase it yourself, push, and retry:" >&2
      echo "  git rebase $main_ref $base" >&2
      exit 2
    fi
  fi
  load_run "$id"
}

load_run() {
  executor_env "$1"
  [[ -d $RUN_WT && -f $MAI_RUN_DIR/directive.txt ]] || { echo "run $1 isn't prepared" >&2; exit 2; }
  DIRECTIVE=$(cat "$MAI_RUN_DIR/directive.txt")
  OPENING="Run id: $MAI_RUN_ID. Run directory: $MAI_RUN_DIR. Working branch: run/$MAI_RUN_ID, started from $(head -n 1 "$MAI_RUN_DIR/base.txt")."
}

# End of run: the run/<id> branch holds the work. Save anything uncommitted as a patch,
# remove the worktree, and delete agent branches whose changes all reached run/<id>,
# whether by merge, cherry-pick or rebase.
finish_run() {
  local id=$1 wt="$root/.worktrees/run-$1" b w
  cd "$root"
  # Agent worktrees normally remove themselves; after a stop or crash they don't.
  for w in $(git worktree list --porcelain | awk -v p="branch refs/heads/agent/$id/" \
               '/^worktree /{w=$2} index($0,p)==1{print w}'); do
    git worktree remove --force "$w" || echo "warning: couldn't remove $w; git worktree prune later" >&2
  done
  rm -f "$root/runs/$id"/agents/*.running
  if [[ -d $wt ]]; then
    if [[ -n $(git -C "$wt" status --porcelain) ]]; then
      git -C "$wt" add -A && git -C "$wt" diff --cached --binary > "$root/runs/$id/executor.uncommitted.patch"
      echo "executor left uncommitted changes: runs/$id/executor.uncommitted.patch"
    fi
    git worktree remove --force "$wt" || echo "warning: couldn't remove $wt; git worktree prune later" >&2
  fi
  # Cleanup is best effort: a concurrent gc or another run may hold ref locks, and
  # a leftover branch must never cost a run its publish and review.
  for b in $(git for-each-ref --format='%(refname:short)' "refs/heads/agent/$id/"); do
    # git cherry marks commits with no equivalent on run/<id> with "+"
    git cherry "run/$id" "$b" | grep -q '^+' || git branch -q -D "$b" 2>/dev/null || true
  done
}

# Push run/<id> and open a draft PR whose body is report, claim and evaluation.
# Plumbing lives here, not in the executor's instructions, so it happens every time.
publish() {
  local id=$1 dir="$root/runs/$1" br="run/$1" base title url
  [[ -n ${GH_TOKEN:-} ]] || { echo "no GH_TOKEN: not publishing $br"; return 0; }
  cd "$root"
  git rev-parse -q --verify "refs/heads/$br" >/dev/null || { echo "no branch $br" >&2; return 2; }
  base=$(gh repo view --json defaultBranchRef -q .defaultBranchRef.name)
  url="$(gh repo view --json url -q .url).git"
  title=$(grep -m1 -v '^[[:space:]]*$' "$dir/report.md" 2>/dev/null | sed 's/^#* *//' | cut -c1-100)
  { cat "$dir/report.md" 2>/dev/null
    printf '\n---\n\n'; cat "$dir/claim.md" 2>/dev/null
    [[ -f $dir/evaluation.md ]] && { printf '\n---\n\n## Independent evaluation\n\n'; cat "$dir/evaluation.md"; }
  } | head -c 60000 > "$dir/pr-body.md"
  local existing; existing=$(gh pr view "$br" --json url -q .url 2>/dev/null || true)
  if { git push "$url" "$br:refs/heads/$br" &&
       if [[ -n $existing ]]; then
         gh pr edit "$br" --body-file "$dir/pr-body.md" && echo "$existing"
       else
         gh pr create --draft --base "$base" --head "$br" --title "${title:-Agent run $id}" --body-file "$dir/pr-body.md"
       fi
     } > "$dir/publish.log" 2>&1; then
    echo "published: $(tail -n 1 "$dir/publish.log")"
    # Track the pushed branch, so checking it out on the host and running
    # git pull / git push just works. Best effort: .git/config may be locked.
    git update-ref "refs/remotes/origin/$br" "$br" 2>/dev/null \
      && git branch -q --set-upstream-to="origin/$br" "$br" 2>/dev/null || true
    if [[ -f $dir/supersedes.txt ]]; then
      local old; old=$(cat "$dir/supersedes.txt")
      gh pr close "run/$old" --comment "Superseded by $(tail -n 1 "$dir/publish.log")" >/dev/null 2>&1 \
        && echo "closed the PR for run/$old (superseded)"
    fi
  else
    echo "publish failed; see runs/$id/publish.log. Retry with: .agents/run publish $id" >&2
  fi
}

# The evaluator gets a throwaway checkout of run/<id>, removed when it finishes.
evaluate() {
  local id=$1 dir="$root/runs/$1" wt="$root/.worktrees/eval-$1"
  [[ -f $dir/claim.md ]] || { echo "no claim.md in $dir" >&2; return 2; }
  git -C "$root" worktree add -q --detach "$wt" "run/$id"
  ( cd "$wt"
    unset MAI_AGENT_ID MAI_AGENT_DEPTH
    run_evaluator "$here/evaluator.md" "Evaluate run $id. Its artifacts are in $dir/. The work is on branch run/$id." ) \
    | tee "$dir/evaluation.md"
  git -C "$root" worktree remove --force "$wt"
}

execute_run() {
    cd "$RUN_WT"
    echo executor > "$MAI_RUN_DIR/phase"
    echo "executor running; log: $MAI_RUN_DIR/executor.log"
    run_executor_batch "$RUN_WT/.agents/executor.md" \
      "Unattended run: nobody will answer until it ends. $OPENING Directive: $DIRECTIVE" \
      > "$MAI_RUN_DIR/executor.log" 2>&1 || true
    [[ -f $MAI_RUN_DIR/claim.md ]] || { finish_run "$MAI_RUN_ID"; echo "failed: no claim.md" > "$MAI_RUN_DIR/phase"; echo "executor wrote no claim.md; see executor.log" >&2; exit 1; }
    echo "evaluating"; echo evaluating > "$MAI_RUN_DIR/phase"
    ( evaluate "$MAI_RUN_ID" > /dev/null ) || true
    echo "post-mortem"; echo post-mortem > "$MAI_RUN_DIR/phase"
    cd "$RUN_WT"
    run_executor_batch "$RUN_WT/.agents/executor.md" \
      "Unattended post-mortem for run $MAI_RUN_ID. Read $MAI_RUN_DIR/evaluation.md and claim.md, then follow 'After evaluation' in your role file. Don't change code." \
      > "$MAI_RUN_DIR/postmortem.log" 2>&1 || true
    finish_run "$MAI_RUN_ID"
    publish "$MAI_RUN_ID"
    build_review "$MAI_RUN_ID"
    echo needs-review > "$MAI_RUN_DIR/phase"
    echo "done. Review: runs/$MAI_RUN_ID/review.md, then .agents/run review $MAI_RUN_ID"
}

case ${1:-} in
  doctor) doctor ;;
  start)
    [[ $# -eq 3 ]] || usage
    doctor || { echo "doctor failed; fix the above before spending on models" >&2; exit 2; }
    setup_run "$2" "$3"
    cd "$RUN_WT"
    run_executor "$RUN_WT/.agents/executor.md" "Interactive run. $OPENING Directive: $3" || true
    finish_run "$MAI_RUN_ID"
    if [[ -f $MAI_RUN_DIR/claim.md ]]; then
      publish "$MAI_RUN_ID"
      build_review "$MAI_RUN_ID"
      echo needs-review > "$MAI_RUN_DIR/phase"
      echo "Review: runs/$MAI_RUN_ID/review.md, then .agents/run review $MAI_RUN_ID"
    else
      echo ended > "$MAI_RUN_DIR/phase"
    fi
    ;;
  auto)
    [[ $# -eq 3 ]] || usage
    doctor || { echo "doctor failed; fix the above before spending on models" >&2; exit 2; }
    setup_run "$2" "$3"
    execute_run
    ;;
  rework)
    [[ $# -ge 3 ]] || usage
    directive=$(rework_directive "$2" "${4:-}") || exit 2
    doctor || { echo "doctor failed; fix the above before spending on models" >&2; exit 2; }
    setup_run "$3" "$directive" "run/$2"
    execute_run
    ;;
  prepare)   # internal: doctor + setup, in the foreground, so errors are visible
    [[ $# -ge 3 ]] || usage
    doctor || { echo "doctor failed; fix the above before spending on models" >&2; exit 2; }
    setup_run "$2" "$3" "${4:-}"
    echo "RUN_ID=$MAI_RUN_ID"
    ;;
  execute)   # internal: the unattended part of auto, for an already prepared run
    [[ $# -eq 2 ]] || usage
    load_run "$2"
    execute_run
    ;;
  eval)
    [[ $# -eq 2 ]] || usage
    evaluate "$2"
    ;;
  finish)    # internal: clean up a stopped or crashed run
    [[ $# -eq 2 ]] || usage
    [[ -d $root/runs/$2 ]] || { echo "no run $2" >&2; exit 2; }
    finish_run "$2"
    echo stopped > "$root/runs/$2/phase"
    echo "cleaned up $2; its branch run/$2 keeps whatever was committed"
    ;;
  review)
    [[ $# -ge 2 ]] || usage
    review_run "$2" "${3:-}" "${4:-}"
    ;;
  sync)
    sync_base || { echo "fetch failed" >&2; exit 1; }
    echo "$BASE_REF $(git rev-parse --short "$BASE_REF")"
    ;;
  publish)
    [[ $# -eq 2 ]] || usage
    publish "$2"
    ;;
  *) usage ;;
esac
