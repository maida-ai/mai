#!/usr/bin/env bash
# .agents/run start <slug> "<directive>"   interactive executor session for a new run
# .agents/run auto <slug> "<directive>"    unattended, in the background: executor, evaluator, post-mortem
# .agents/run status [run-id]              progress of a run (default: latest); runs on the host
# .agents/run eval <run-id>                run the independent evaluator on a finished run
# .agents/run doctor                       check the environment; no model calls
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$here/.." && pwd)
# shellcheck source=/dev/null
source "$here/tiers.sh"
usage() { sed -n '2,6p' "$0" | sed 's/^# //'; exit 2; }

# Read-only view of a run, from the files it writes. Needs no container.
status() {
  local id=${1:-$(ls -1t "$root/runs" 2>/dev/null | head -n 1)}
  local dir="$root/runs/$id"
  [[ -n $id && -d $dir ]] || { echo "no runs yet" >&2; return 2; }
  local cname="mai-$id" state="not running"
  if command -v docker >/dev/null && docker ps --format '{{.Names}}' 2>/dev/null | grep -qx "$cname"; then
    state="running ($cname)"
  fi
  local started; started=$(stat -c %Y "$dir/directive.txt" 2>/dev/null || echo 0)
  echo "run      $id"
  echo "phase    $(cat "$dir/phase" 2>/dev/null || echo interactive)   container: $state"
  echo "elapsed  $(( ($(date +%s) - started) / 60 )) min"
  echo "directive: $(head -c 160 "$dir/directive.txt")"
  echo
  if [[ -f $dir/spawns.jsonl ]]; then
    echo "finished agents:"
    python3 - "$dir/spawns.jsonl" <<'PY'
import json, sys
for line in open(sys.argv[1]):
    r = json.loads(line)
    print(f"  {r['id']:<28} {r['role']:<11} {r['tier']:<5} {r['status']:<11} exit={r['exit']}")
PY
  fi
  local f any=""
  for f in "$dir"/agents/*.running; do
    [[ -e $f ]] || continue
    [[ -z $any ]] && { echo "running agents:"; any=1; }
    echo "  $(basename "$f" .running)  $(( ($(date +%s) - $(stat -c %Y "$f")) / 60 )) min"
  done
  for f in triage.md scope.md claim.md evaluation.md proposals.md escalations.md report.md; do
    [[ -f $dir/$f ]] && printf '%s ' "$f"
  done; echo
  local log="$dir/executor.log"
  [[ -f $dir/postmortem.log ]] && log="$dir/postmortem.log"
  if [[ -f $log ]]; then echo; echo "tail of $(basename "$log"):"; tail -n 15 "$log" | sed 's/^/  /'; fi
}

[[ ${1:-} == status ]] && { shift; status "$@"; exit $?; }

# On the host, re-run this same command inside the container. Agents run with the
# sandbox bypassed, which is only acceptable in a disposable box.
if [[ -z ${MAI_IN_CONTAINER:-} ]]; then
  command -v docker >/dev/null || { echo "docker not found; agents only run in the container" >&2; exit 2; }
  docker info >/dev/null 2>&1 || {
    echo "can't reach the Docker daemon as $USER. Check: docker run --rm hello-world" >&2
    echo "Fix: add yourself to the docker group, or use rootless Docker. Don't run this with sudo." >&2
    exit 2; }
  docker image inspect mai-agents >/dev/null 2>&1 \
    || docker build -t mai-agents -f "$here/Dockerfile" "$here"
  # Mount only your Codex login. The rest of ~/.codex is host-specific (installed
  # binaries, symlinks to host paths); the container keeps its own copy in a volume.
  auth=()
  if [[ -f $HOME/.codex/auth.json ]]; then
    auth=(-v "$HOME/.codex/auth.json":/root/.codex/auth.json)
  elif [[ -z ${OPENAI_API_KEY:-} ]]; then
    echo "no ~/.codex/auth.json and no OPENAI_API_KEY; log in to codex on the host first" >&2
    exit 2
  fi
  # Same path inside and out, so worktree paths and logs stay valid on the host.
  common=(--rm --init -v "$root":"$root" -w "$root"
          -v mai-codex-home:/root/.codex ${auth[@]+"${auth[@]}"}
          -e OPENAI_API_KEY -e GH_TOKEN -e MAI_IN_CONTAINER=1)
  if [[ ${1:-} == auto ]]; then
    [[ $# -eq 3 ]] || usage
    docker run "${common[@]}" mai-agents "$here/run" doctor \
      || { echo "doctor failed; fix the above before spending on models" >&2; exit 2; }
    cname="mai-$(date -u +%F)-$2"
    docker run -d --name "$cname" "${common[@]}" mai-agents "$here/run" "$@" >/dev/null
    echo "started $cname in the background"
    echo "  progress:  .agents/run status        (or: watch -n 15 .agents/run status)"
    echo "  phases:    docker logs -f $cname"
    echo "  inside:    docker exec -it $cname bash"
    echo "  stop:      docker stop $cname"
    exit 0
  fi
  tty=-i; [[ -t 0 && -t 1 ]] && tty=-it
  name=(); [[ ${1:-} == start ]] && name=(--name "mai-$(date -u +%F)-${2:-x}")
  exec docker run $tty ${name[@]+"${name[@]}"} "${common[@]}" mai-agents "$here/run" "$@"
fi

KIT=(INTENT.md AGENTS.md CLAUDE.md .agents)
[[ -n ${GH_TOKEN:-} ]] && gh auth setup-git >/dev/null 2>&1 || true

doctor() {
  local fail=0
  ok() { echo "ok    $*"; }
  bad() { echo "FAIL  $*"; fail=1; }
  warn() { echo "warn  $*"; }
  cd "$root"

  command -v cargo >/dev/null && ok "cargo $(cargo --version | cut -d' ' -f2)" || bad "cargo not on PATH"
  bash -lc 'command -v cargo' >/dev/null 2>&1 && ok "cargo in login shell" || bad "cargo missing in login shell"
  local gv; gv=$(git --version | awk '{print $3}')
  [[ $(printf '2.40\n%s\n' "$gv" | sort -V | head -n 1) == 2.40 ]] && ok "git $gv" || bad "git $gv < 2.40"
  command -v codex >/dev/null && ok "codex on PATH" || bad "codex not on PATH"
  [[ -f $HOME/.codex/auth.json || -n ${OPENAI_API_KEY:-} ]] && ok "codex auth" || bad "no codex auth"
  if [[ -n ${GH_TOKEN:-} ]]; then
    if gh auth status >/dev/null 2>&1; then
      ok "gh authenticated"
      # Dry-run push to a probe ref: contacts GitHub with write auth, changes nothing.
      if git push --dry-run "$(gh repo view --json url -q .url).git" HEAD:refs/heads/mai-doctor-probe >/dev/null 2>&1; then
        ok "GH_TOKEN can push branches"
      else
        warn "GH_TOKEN can't push: runs won't publish a branch or PR (token needs Contents: read/write)"
      fi
    else
      bad "GH_TOKEN set but gh auth fails"
    fi
  else
    warn "no GH_TOKEN: no issue grooming, no push, no PR"
  fi
  git check-ignore -q runs/x && git check-ignore -q .worktrees/x && ok "runs/ and .worktrees/ ignored" || bad "add runs/ and .worktrees/ to .gitignore"
  [[ -x $(git rev-parse --path-format=absolute --git-common-dir)/hooks/pre-commit ]] \
    && ok "pre-commit hook installed" || bad "pre-commit hook missing"

  # Agents' worktrees branch from HEAD, so they only see the committed kit.
  if git diff --quiet HEAD -- "${KIT[@]}" && [[ -z $(git ls-files --others --exclude-standard -- "${KIT[@]}") ]]; then
    ok "kit committed"
  else
    bad "kit has uncommitted changes; agents' worktrees won't see them. Commit: ${KIT[*]}"
    echo "skip  spawn test (needs a committed kit)"
    return $fail
  fi

  # Depth-2 and depth-3 spawn through the committed kit, with a stub instead of a model.
  local tmp; tmp=$(mktemp -d)
  cat > "$tmp/tiers.sh" <<'STUB'
CHEAP_DESC=stub
run_cheap() {
  if grep -q '^Role: planner' "$1"; then
    printf 'TASK: doctor-impl\nDONE WHEN: true\n' > "$MAI_RUN_DIR/briefs/impl.md"
    .agents/spawn cheap implementer "$MAI_RUN_DIR/briefs/impl.md" >/dev/null || { echo "STATUS: failed"; return; }
  fi
  echo "STATUS: done"
}
STUB
  mkdir -p "$tmp/run/briefs"
  printf 'TASK: doctor-plan\nDONE WHEN: true\n' > "$tmp/run/briefs/plan.md"
  local rid="doctor-$$"
  ( export MAI_RUN_ID=$rid MAI_RUN_DIR=$tmp/run MAI_TIERS_FILE=$tmp/tiers.sh \
           MAI_WORKTREE_ROOT=$tmp/wt MAI_AGENT_DEPTH=1 MAI_AGENT_ID=doctor
    "$here/spawn" cheap planner "$tmp/run/briefs/plan.md" ) >/dev/null 2>&1
  local done_rows; done_rows=$(grep -c '"status":"done"' "$tmp/run/spawns.jsonl" 2>/dev/null || true)
  [[ $done_rows == 2 ]] && ok "spawn depth 2 and 3" \
    || bad "spawn test: expected 2 done rows, got ${done_rows:-0}; see $tmp/run"
  local w b
  for w in "$tmp"/wt/*; do [[ -d $w ]] && git worktree remove --force "$w"; done
  for b in $(git for-each-ref --format='%(refname:short)' "refs/heads/agent/$rid/"); do git branch -q -D "$b"; done
  [[ $fail == 0 ]] && rm -rf "$tmp"
  return $fail
}

# Set up a run: env, run dir, and the executor's own worktree on branch run/<run-id>,
# so your checkout is never touched.
setup_run() {
  export MAI_RUN_ID="$(date +%F)-$1"
  export MAI_RUN_DIR="$root/runs/$MAI_RUN_ID"
  export MAI_WORKTREE_ROOT="$root/.worktrees"
  export MAI_AGENT_DEPTH=1 MAI_AGENT_ID=executor
  export GIT_AUTHOR_NAME="mai-executor" GIT_AUTHOR_EMAIL="executor@agents.mai.local"
  export GIT_COMMITTER_NAME="$GIT_AUTHOR_NAME" GIT_COMMITTER_EMAIL="$GIT_AUTHOR_EMAIL"
  [[ -e $MAI_RUN_DIR ]] && { echo "run exists: $MAI_RUN_DIR" >&2; exit 2; }
  mkdir -p "$MAI_RUN_DIR/briefs"
  printf '%s\n' "$2" > "$MAI_RUN_DIR/directive.txt"
  RUN_WT="$MAI_WORKTREE_ROOT/run-$MAI_RUN_ID"
  git -C "$root" worktree add -q -b "run/$MAI_RUN_ID" "$RUN_WT" HEAD
  OPENING="Run id: $MAI_RUN_ID. Run directory: $MAI_RUN_DIR. Working branch: run/$MAI_RUN_ID."
}

# End of run: the run/<id> branch holds the work. Save anything uncommitted as a patch,
# remove the worktree, and delete agent branches already merged into run/<id>.
finish_run() {
  local id=$1 wt="$root/.worktrees/run-$1" b
  cd "$root"
  if [[ -d $wt ]]; then
    if [[ -n $(git -C "$wt" status --porcelain) ]]; then
      git -C "$wt" add -A && git -C "$wt" diff --cached --binary > "$root/runs/$id/executor.uncommitted.patch"
      echo "executor left uncommitted changes: runs/$id/executor.uncommitted.patch"
    fi
    git worktree remove --force "$wt"
  fi
  for b in $(git for-each-ref --format='%(refname:short)' --merged "run/$id" "refs/heads/agent/$id/"); do
    git branch -q -D "$b"   # merged into run/<id>, checked above; -d would check HEAD
  done
}

# The evaluator gets a throwaway checkout of run/<id>, removed when it finishes.
evaluate() {
  local id=$1 dir="$root/runs/$1" wt="$root/.worktrees/eval-$1"
  [[ -f $dir/claim.md ]] || { echo "no claim.md in $dir" >&2; return 2; }
  git -C "$root" worktree add -q --detach "$wt" "run/$id"
  ( cd "$wt"
    unset MAI_AGENT_ID MAI_AGENT_DEPTH
    run_evaluator "$here/evaluator.md" "Evaluate run $id. Its artifacts are in $dir/. The work is on branch run/$id." ) \
    | tee "$dir/evaluation.md"
  git -C "$root" worktree remove --force "$wt"
}

case ${1:-} in
  doctor) doctor ;;
  start)
    [[ $# -eq 3 ]] || usage
    doctor || { echo "doctor failed; fix the above before spending on models" >&2; exit 2; }
    setup_run "$2" "$3"
    cd "$RUN_WT"
    run_executor "$RUN_WT/.agents/executor.md" "Interactive run. $OPENING Directive: $3" || true
    finish_run "$MAI_RUN_ID"
    ;;
  auto)
    [[ $# -eq 3 ]] || usage
    doctor || { echo "doctor failed; fix the above before spending on models" >&2; exit 2; }
    setup_run "$2" "$3"
    cd "$RUN_WT"
    echo executor > "$MAI_RUN_DIR/phase"
    echo "executor running; log: $MAI_RUN_DIR/executor.log"
    run_executor_batch "$RUN_WT/.agents/executor.md" \
      "Unattended run: nobody will answer until it ends. $OPENING Directive: $3" \
      > "$MAI_RUN_DIR/executor.log" 2>&1 || true
    [[ -f $MAI_RUN_DIR/claim.md ]] || { finish_run "$MAI_RUN_ID"; echo "failed: no claim.md" > "$MAI_RUN_DIR/phase"; echo "executor wrote no claim.md; see executor.log" >&2; exit 1; }
    echo "evaluating"; echo evaluating > "$MAI_RUN_DIR/phase"
    ( evaluate "$MAI_RUN_ID" > /dev/null ) || true
    echo "post-mortem"; echo post-mortem > "$MAI_RUN_DIR/phase"
    cd "$RUN_WT"
    run_executor_batch "$RUN_WT/.agents/executor.md" \
      "Unattended post-mortem for run $MAI_RUN_ID. Read $MAI_RUN_DIR/evaluation.md and claim.md, then follow 'After evaluation' in your role file. Don't change code." \
      > "$MAI_RUN_DIR/postmortem.log" 2>&1 || true
    finish_run "$MAI_RUN_ID"
    echo done > "$MAI_RUN_DIR/phase"
    echo "done. Read: $MAI_RUN_DIR/{report.md,evaluation.md,proposals.md,escalations.md}"
    ;;
  eval)
    [[ $# -eq 2 ]] || usage
    evaluate "$2"
    ;;
  *) usage ;;
esac
